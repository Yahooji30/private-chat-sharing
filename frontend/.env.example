# Frontend: the app (single page app) on PORT. Copy to frontend/.env, then run `pnpm build` (these values are read at build and at start).
PORT=3000
NUXT_PUBLIC_APP_NAME=Jodbox
# where the browser reaches the realtime service (backend RT_PORT). Leave empty only if a reverse proxy serves /socket.io on this origin.
NUXT_PUBLIC_RT_URL=http://localhost:4001
# the blog site (separate app); leave empty to hide the Blog, Privacy and Terms links. With the blog under /blog use https://example.com/blog
NUXT_PUBLIC_BLOG_URL=http://localhost:3001
# where this server forwards /api requests (backend API_PORT)
NUXT_API_INTERNAL=http://127.0.0.1:4000

# Google AdSense (optional). Leave the client empty to show labelled ad-space previews instead of real ads.
# Master switch: false hides every ad space (and no ad script loads) on the whole site
NUXT_PUBLIC_ADS_ENABLED=true
NUXT_PUBLIC_ADSENSE_CLIENT=
NUXT_PUBLIC_AD_SLOT_RAIL=
NUXT_PUBLIC_AD_SLOT_INLINE=
NUXT_PUBLIC_AD_SLOT_BANNER=
NUXT_PUBLIC_ADS_PREVIEW=true
