{
  "name": "sync",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @sync/backend --filter @sync/frontend dev",
