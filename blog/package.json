  },
  "dependencies": { "@sync/shared": "workspace:*", "nuxt": "^4.1.0", "vue": "^3.5.0", "@vueuse/core": "^13.0.0", "@vueuse/nuxt": "^13.0.0" },
  "devDependencies": { "@tailwindcss/vite": "^4.1.0", "tailwindcss": "^4.1.0", "typescript": "^5.9.0", "vue-tsc": "^3.0.0" }
}
