# Blog site (server rendered: blog, public pages, privacy, terms, sitemap, RSS) on PORT. Copy to blog/.env.
PORT=3001
NUXT_PUBLIC_APP_NAME=Sync
# this site's own public address, and the app's address (for links and canonical URLs)
NUXT_PUBLIC_SITE_URL=http://localhost:3001
NUXT_PUBLIC_APP_URL=http://localhost:3000
# where this server reads content from (backend API_PORT)
NUXT_API_INTERNAL=http://127.0.0.1:4000
# same value as REVALIDATE_SECRET in backend/.env: lets the backend purge cached pages when you publish
NUXT_REVALIDATE_SECRET=dev-revalidate-secret
