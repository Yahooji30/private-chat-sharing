# Admin panel. Copy to admin/.env.
PORT=5173
# 127.0.0.1 = only nginx on this machine can reach the panel (recommended). 0.0.0.0 = every network.
HOST=127.0.0.1
# false = never believe X-Forwarded-For (use when the panel can be reached directly). Keep true behind nginx.
TRUST_PROXY=true
# the backend API; /api and /media are forwarded here (dev server and production server)
ADMIN_API_URL=http://127.0.0.1:4000
